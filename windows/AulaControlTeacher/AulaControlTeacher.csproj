<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TabletEscolarTeacher</AssemblyName>
    <RootNamespace>AulaControlTeacher</RootNamespace>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Product>Tablet Escolar</Product>
    <Company>Desarrollador Eduardo Pérez González</Company>
    <Authors>Eduardo Pérez González</Authors>
    <Copyright>© 2026 Eduardo Pérez González</Copyright>
    <Description>Consola docente para gestión, supervisión en vivo y sesiones temporales de tablets Android institucionales</Description>
    <ApplicationIcon>TabletEscolar.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="TabletEscolar.ico" />
  </ItemGroup>
</Project>
