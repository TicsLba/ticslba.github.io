<Application x:Class="PangiConsole.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 ShutdownMode="OnMainWindowClose">
 <Application.Resources>
  <SolidColorBrush x:Key="Primary" Color="#18A77C"/>
  <SolidColorBrush x:Key="PangiObsidian" Color="#111820"/>
  <SolidColorBrush x:Key="PangiPetrol" Color="#123844"/>
  <SolidColorBrush x:Key="PangiIvory" Color="#F5F7F7"/>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="12,8"/>
   <Setter Property="Margin" Value="3"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
 </Application.Resources>
</Application>